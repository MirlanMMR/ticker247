<?xml version="1.0" encoding="utf-8"?>
<!--
    Иконка для системного сплэш-экрана.

    Отдельная от ic_launcher_foreground намеренно: splash-иконку Android
    обрезает по кругу (виден примерно центральный 2/3 квадрата), из-за чего
    надпись «T24/7» из launcher-иконки срезалась и кадр выглядел как артефакт.
    Здесь только три молнии, отцентрованные и вписанные в безопасную зону.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:pivotX="54"
        android:pivotY="54"
        android:translateY="12.75">

        <!-- Левая молния — белая (INFO), чуть меньше -->
        <path
            android:fillColor="#BBFFFFFF"
            android:pathData="M30,20 L20,38 H27 L25,52 L40,32 H33 Z"/>

        <!-- Центральная молния — голубая (IMPORTANT), самая большая -->
        <path
            android:fillColor="#00D4FF"
            android:pathData="M54,14 L41,42 H50 L48,64 L67,36 H58 Z"/>

        <!-- Правая молния — оранжевая (URGENT), чуть меньше -->
        <path
            android:fillColor="#FF5722"
            android:pathData="M78,20 L68,38 H75 L73,52 L88,32 H81 Z"/>
    </group>

</vector>
