<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Фон: графитовый градиент — в тон остальному приложению -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#24262C"
                android:centerColor="#2A2D34"
                android:endColor="#2E313A"
                android:type="linear" />
        </shape>
    </item>

    <!-- Логотип ⚡ по центру — белый круг + молния -->
    <item
        android:gravity="center"
        android:width="120dp"
        android:height="120dp">
        <layer-list>
            <!-- Круг с мягким свечением -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#3300D4FF" />
                </shape>
            </item>
            <item
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp">
                <shape android:shape="oval">
                    <solid android:color="#664A4E58" />
                </shape>
            </item>
            <item
                android:left="16dp"
                android:top="16dp"
                android:right="16dp"
                android:bottom="16dp">
                <shape android:shape="oval">
                    <solid android:color="#FF4A4E58" />
                </shape>
            </item>
        </layer-list>
    </item>

</layer-list>
